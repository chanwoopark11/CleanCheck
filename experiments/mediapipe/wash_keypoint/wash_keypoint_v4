def reset_wash_status():
    """
    모든 손 씻기 관련 상태 변수들을 초기화합니다.
    새로운 손 씻기 세션을 시작하거나 'r' 키가 눌렸을 때 호출됩니다.
    """
    global cleansed_state, contact_timers, stable_orientations, orientation_counters, active_scenario_global, last_known_landmarks_prev_frame # yolo_action_buffer
    cleansed_state = {
        "Left": {"palm": [False]*21, "back": [False]*21},
        "Right": {"palm": [False]*21, "back": [False]*21}
    }
    contact_timers = {
        "Left": {"palm": [0]*21, "back": [0]*21},
        "Right": {"palm": [0]*21, "back": [0]*21}
    }
    stable_orientations = {"Left": "palm", "Right": "palm"} # 초기 손 방향 기본값 설정
    orientation_counters = {"Left": 0, "Right": 0} # 방향 카운터 초기화
    active_scenario_global = 0 # 시나리오 초기화
    last_known_landmarks_prev_frame = {"Left": None, "Right": None} # 이전 랜드마크 초기화


# (calculate_movement_magnitude 함수는 현재 사용되지 않지만, 필요 시를 위해 남겨둡니다.)
def calculate_movement_magnitude(current_landmarks, previous_landmarks):
    """
    현재 프레임과 이전 프레임의 랜드마크를 비교하여 손의 움직임 크기를 계산합니다.
    각 랜드마크의 이동 거리 합계를 반환합니다.

    Args:
        current_landmarks (dict): 현재 프레임의 랜드마크 픽셀 좌표.
        previous_landmarks (dict): 이전 프레임의 랜드마크 픽셀 좌표.

    Returns:
        float: 모든 랜드마크의 총 이동 거리 합계.
    """
    if not current_landmarks or not previous_landmarks:
        return 0.0
    
    total_movement = 0.0
    for idx in current_landmarks:
        if idx in previous_landmarks:
            curr_x, curr_y = current_landmarks[idx]
            prev_x, prev_y = previous_landmarks[idx]
            total_movement += np.sqrt((curr_x - prev_x)**2 + (curr_y - prev_y)**2)
    return total_movement


def update_cleansed_status(pred_left, pred_right, facing_left_is_palm, facing_right_is_palm, current_action):
    """
    손의 랜드마크와 방향, 그리고 YOLO 감지 결과를 바탕으로 손의 세척 상태를 업데이트합니다.
    다양한 손 씻기 시나리오를 처리합니다.

    Args:
        pred_left (dict): 칼만 필터링된 왼손 랜드마크 픽셀 좌표.
        pred_right (dict): 칼만 필터링된 오른손 랜드마크 픽셀 좌표.
        facing_left_is_palm (bool): 왼손이 손바닥을 향하고 있는지 여부.
        facing_right_is_palm (bool): 오른손이 손바닥을 향하고 있는지 여부.
        current_action (int): YOLO 모델이 현재 감지한 손 씻기 동작 클래스 ID.
                               (0: 손바닥 비비기, 2: 손등 비비기, -1: 미감지 또는 기타)
    """
    global active_scenario_global, last_known_landmarks_prev_frame
    now = time.time()
    
    # -------------------------------------------------------------------------
    # 1. 두 손 중 하나라도 감지되지 않았을 경우 초기화
    # -------------------------------------------------------------------------
    if not pred_left or not pred_right:
        # 모든 손 랜드마크의 접촉 타이머를 0으로 리셋합니다.
        for i in range(21):
            for hand in ["Left", "Right"]:
                for side in ["palm", "back"]: contact_timers[hand][side][i] = 0
        # 현재 활성 시나리오를 '0' (미감지)으로 설정합니다.
        active_scenario_global = 0
        # 이전 프레임의 랜드마크 정보를 현재 상태로 업데이트합니다.
        last_known_landmarks_prev_frame["Left"] = pred_left
        last_known_landmarks_prev_frame["Right"] = pred_right
        return # 함수 종료

    # -------------------------------------------------------------------------
    # 2. 손의 Convex Hull (볼록 껍질) 계산
    # -------------------------------------------------------------------------
    # 랜드마크 좌표를 NumPy 배열로 변환하여 Convex Hull 계산에 사용합니다.
    left_points = np.array(list(pred_left.values()), dtype=np.int32)
    right_points = np.array(list(pred_right.values()), dtype=np.int32)
    # 각 손의 볼록 껍질을 계산합니다. (최소 3개 이상의 점이 있어야 함)
    left_hull = cv2.convexHull(left_points) if len(left_points) >= 3 else None
    right_hull = cv2.convexHull(right_points) if len(right_points) >= 3 else None
    
    # -------------------------------------------------------------------------
    # 3. Convex Hull 계산 실패 시 초기화
    # -------------------------------------------------------------------------
    # 볼록 껍질 계산에 실패한 경우 (예: 점이 부족하거나 오류 발생) 타이머를 리셋합니다.
    if left_hull is None or right_hull is None: 
        for i in range(21):
            for hand in ["Left", "Right"]:
                for side in ["palm", "back"]: contact_timers[hand][side][i] = 0
        active_scenario_global = 0
        last_known_landmarks_prev_frame["Left"] = pred_left
        last_known_landmarks_prev_frame["Right"] = pred_right
        return # 함수 종료

    # -------------------------------------------------------------------------
    # 4. YOLO 감지 결과에 따른 시나리오 처리
    # -------------------------------------------------------------------------
    if current_action == 0 or current_action == 2:
        # 시나리오 1: YOLO가 '손바닥 비비기' (0) 또는 '손등 비비기' (2)를 직접 감지한 경우
        active_scenario_global = 1 # 시나리오 1 활성화

        # 왼손 랜드마크 처리 (오른손 볼록 껍질과의 접촉 확인)
        for i, point_left in pred_left.items():
            is_in_contact = cv2.pointPolygonTest(right_hull, point_left, False) >= 0
            if is_in_contact:
                # 접촉 중일 때 손바닥 타이머를 시작/갱신합니다.
                if contact_timers["Left"]["palm"][i] == 0: contact_timers["Left"]["palm"][i] = now
                contact_timers["Left"]["back"][i] = 0 # 손등 타이머는 리셋 (이 시나리오에서는 손바닥만 중요)
                # 일정 시간 이상 접촉하면 손바닥 랜드마크를 세척된 것으로 표시합니다.
                if now - contact_timers["Left"]["palm"][i] > CONTACT_TIME_THRESHOLD: 
                    cleansed_state["Left"]["palm"][i] = True
            else: 
                # 접촉이 없으면 양쪽 타이머를 리셋합니다.
                contact_timers["Left"]["palm"][i] = 0
                contact_timers["Left"]["back"][i] = 0

        # 오른손 랜드마크 처리 (왼손 볼록 껍질과의 접촉 확인)
        for i, point_right in pred_right.items():
            is_in_contact = cv2.pointPolygonTest(left_hull, point_right, False) >= 0
            if is_in_contact:
                # 접촉 중일 때 손바닥 타이머를 시작/갱신합니다.
                if contact_timers["Right"]["palm"][i] == 0: contact_timers["Right"]["palm"][i] = now
                contact_timers["Right"]["back"][i] = 0 # 손등 타이머는 리셋
                # 일정 시간 이상 접촉하면 손바닥 랜드마크를 세척된 것으로 표시합니다.
                if now - contact_timers["Right"]["palm"][i] > CONTACT_TIME_THRESHOLD: 
                    cleansed_state["Right"]["palm"][i] = True
            else: 
                # 접촉이 없으면 양쪽 타이머를 리셋합니다.
                contact_timers["Right"]["palm"][i] = 0
                contact_timers["Right"]["back"][i] = 0

    # -------------------------------------------------------------------------
    # 5. YOLO가 특정 동작을 감지하지 못했지만 MediaPipe가 손을 감지한 경우 (-1)
    # -------------------------------------------------------------------------
    elif current_action == -1 and pred_left and pred_right:
        # 시나리오 2: 한 손은 손바닥을, 다른 한 손은 손등을 향하고 있는 경우 (예: 왼손 손바닥, 오른손 손등 또는 그 반대)
        if (facing_left_is_palm and not facing_right_is_palm) or \
           (not facing_left_is_palm and facing_right_is_palm):
            active_scenario_global = 2 # 시나리오 2 활성화
            
            # 이 시나리오에서는 손의 실제 방향과 관계없이 '손바닥만' 세척 대상으로 간주합니다.
            
            # 왼손 랜드마크 처리
            for i, point_left in pred_left.items():
                is_in_contact = cv2.pointPolygonTest(right_hull, point_left, False) >= 0
                if is_in_contact:
                    # 왼손 접촉 시 항상 손바닥 세척 시도
                    if contact_timers["Left"]["palm"][i] == 0: contact_timers["Left"]["palm"][i] = now
                    contact_timers["Left"]["back"][i] = 0 # 손등 타이머는 항상 리셋
                    if now - contact_timers["Left"]["palm"][i] > CONTACT_TIME_THRESHOLD: 
                        cleansed_state["Left"]["palm"][i] = True
                else: 
                    contact_timers["Left"]["palm"][i] = 0
                    contact_timers["Left"]["back"][i] = 0

            # 오른손 랜드마크 처리
            for i, point_right in pred_right.items():
                is_in_contact = cv2.pointPolygonTest(left_hull, point_right, False) >= 0
                if is_in_contact:
                    # 오른손 접촉 시 항상 손바닥 세척 시도
                    if contact_timers["Right"]["palm"][i] == 0: contact_timers["Right"]["palm"][i] = now
                    contact_timers["Right"]["back"][i] = 0 # 손등 타이머는 항상 리셋
                    if now - contact_timers["Right"]["palm"][i] > CONTACT_TIME_THRESHOLD: 
                        cleansed_state["Right"]["palm"][i] = True
                else: 
                    contact_timers["Right"]["palm"][i] = 0
                    contact_timers["Right"]["back"][i] = 0
        
        # 시나리오 3: 양손이 모두 손등으로 감지된 경우
        elif not facing_left_is_palm and not facing_right_is_palm: 
            active_scenario_global = 3 # 시나리오 3 활성화
            
            # 이 시나리오에서는 양손 모두 '손등만' 세척 대상으로 간주합니다.
            
            # 왼손 랜드마크 처리
            for i, point_left in pred_left.items():
                is_in_contact = cv2.pointPolygonTest(right_hull, point_left, False) >= 0
                if is_in_contact:
                    # 왼손 접촉 시 항상 손등 세척 시도
                    if contact_timers["Left"]["back"][i] == 0: contact_timers["Left"]["back"][i] = now
                    contact_timers["Left"]["palm"][i] = 0 # 손바닥 타이머는 항상 리셋
                    if now - contact_timers["Left"]["back"][i] > CONTACT_TIME_THRESHOLD: 
                        cleansed_state["Left"]["back"][i] = True
                else: 
                    contact_timers["Left"]["palm"][i] = 0
                    contact_timers["Left"]["back"][i] = 0
            
            # 오른손 랜드마크 처리
            for i, point_right in pred_right.items():
                is_in_contact = cv2.pointPolygonTest(left_hull, point_right, False) >= 0
                if is_in_contact:
                    # 오른손 접촉 시 항상 손등 세척 시도
                    if contact_timers["Right"]["back"][i] == 0: contact_timers["Right"]["back"][i] = now
                    contact_timers["Right"]["palm"][i] = 0 # 손바닥 타이머는 항상 리셋
                    if now - contact_timers["Right"]["back"][i] > CONTACT_TIME_THRESHOLD: 
                        cleansed_state["Right"]["back"][i] = True
                else: 
                    contact_timers["Right"]["palm"][i] = 0
                    contact_timers["Right"]["back"][i] = 0
        else: # MediaPipe가 손을 감지했지만 위 두 시나리오 조건에 맞지 않는 경우
              # (예: 양손 모두 손바닥을 향하고 있는 경우)
            active_scenario_global = 3 # 이 경우 시나리오 3으로 처리하고 타이머를 리셋하여 특별한 세척 동작은 인식하지 않습니다.
            for i in range(21):
                for hand in ["Left", "Right"]:
                    for side in ["palm", "back"]: contact_timers[hand][side][i] = 0
    # -------------------------------------------------------------------------
    # 6. 기타 경우 (YOLO가 0, 2 외의 다른 클래스를 감지했거나, 한 손만 감지 등)
    # -------------------------------------------------------------------------
    else: 
        active_scenario_global = 3 # 이 경우도 시나리오 3으로 처리하고 모든 타이머를 리셋합니다.
        for i in range(21):
            for hand in ["Left", "Right"]:
                for side in ["palm", "back"]: contact_timers[hand][side][i] = 0
    
    # -------------------------------------------------------------------------
    # 7. 마지막으로 알려진 랜드마크 정보 업데이트
    # -------------------------------------------------------------------------
    # 다음 프레임에서의 움직임 계산을 위해 현재 랜드마크 정보를 저장합니다.
    last_known_landmarks_prev_frame["Left"] = pred_left
    last_known_landmarks_prev_frame["Right"] = pred_right

def draw_hand_visuals(image, landmarks, label, is_palm):
    """
    프레임에 손 랜드마크와 세척 상태를 시각화하여 그립니다.
    세척된 부분은 색상으로 표시하고, 손바닥/손등 방향 텍스트를 추가합니다.

    Args:
        image (np.array): 그릴 대상 이미지 (프레임).
        landmarks (dict): 손 랜드마크 픽셀 좌표.
        label (str): 손의 라벨 ("Left" 또는 "Right").
        is_palm (bool): 현재 손바닥이 카메라를 향하고 있는지 여부.
    """
    if not landmarks:
        return

    overlay = image.copy()
    hull_points = [landmarks[i] for i in range(21) if i in landmarks]
    side = "palm" if is_palm else "back" 

    if len(hull_points) > 2:
        hull = cv2.convexHull(np.array(hull_points, dtype=np.int32))
        
        if label in cleansed_state and side in cleansed_state[label]:
            # 세척된 랜드마크 개수를 세어 진행률에 따라 손 영역 색칠
            washed_count = sum(1 for i in range(21) if cleansed_state[label][side][i])
            wash_ratio = washed_count / 21
            if wash_ratio > 0.1: # 일정 비율 이상 세척되었을 때만 색상 적용
                color = PALM_WASHED_COLOR if is_palm else BACK_WASHED_COLOR
                alpha = min(0.1 + wash_ratio * 0.6, 0.7) # 세척 비율에 따라 투명도 조절
                cv2.fillConvexPoly(overlay, hull, color)
                cv2.addWeighted(overlay, alpha, image, 1 - alpha, 0, image)

    # 개별 랜드마크 세척 상태 시각화
    if label in cleansed_state and side in cleansed_state[label]:
        for i, point in landmarks.items():
            color = (PALM_WASHED_COLOR if is_palm else BACK_WASHED_COLOR) if cleansed_state[label][side][i] else UNWASHED_COLOR
            cv2.circle(image, point, 8, color, -1) # 랜드마크 점 채우기
            cv2.circle(image, point, 8, (0, 0, 0), 1) # 랜드마크 점 테두리

    # 손의 라벨과 방향 텍스트 표시
    if 0 in landmarks: # 손목 랜드마크(0번)를 기준으로 텍스트 위치 설정
        label_text = f"{label} - {side.capitalize()}"
        cv2.putText(image, label_text, (landmarks[0][0] - 50, landmarks[0][1] + 50), cv2.FONT_HERSHEY_SIMPLEX, 0.8, TEXT_COLOR, 2)

def draw_progress_bar(image, current_action_from_yolo): 
    """
    화면 상단에 전체 손 씻기 진행률 바와 하단에 현재 감지된 시나리오 정보를 표시합니다.

    Args:
        image (np.array): 그릴 대상 이미지 (프레임).
        current_action_from_yolo (int): YOLO가 현재 감지한 동작 클래스 ID.
                                       (버퍼링을 거치지 않은 원시 액션 값)
    """
    global active_scenario_global 
    
    # 전체 랜드마크 개수 (양손 손바닥 21 + 양손 손등 21 = 42, 각 랜드마크는 palm/back 2개 상태 = 84)
    total_points = 21 * 2 * 2 # 21 랜드마크 * 2 손 * 2 면 (손바닥/손등)
    # 현재 세척된 랜드마크 개수 합산
    washed_points = sum(sum(cleansed_state[hand][side]) for hand in cleansed_state for side in cleansed_state[hand])
    
    progress = washed_points / total_points if total_points > 0 else 0 # 진행률 계산
    bar_width = int((image.shape[1] - 40) * progress) # 진행률 바 너비 계산
    
    # 진행률 바 배경 그리기
    cv2.rectangle(image, (20, 20), (image.shape[1] - 20, 50), (100, 100, 100), -1) 
    # 진행률 바 채우기
    if bar_width > 0: 
        cv2.rectangle(image, (20, 20), (20 + bar_width, 50), (0, 255, 127), -1) # 밝은 초록색
    
    # 진행률 텍스트 표시
    cv2.putText(image, f"Wash Progress: {progress:.0%}", (30, 42), cv2.FONT_HERSHEY_SIMPLEX, 0.7, TEXT_COLOR, 2)
    # 리셋 안내 텍스트
    cv2.putText(image, "Press 'r' to Reset", (image.shape[1] - 180, image.shape[0] - 20), cv2.FONT_HERSHEY_SIMPLEX, 0.7, (0, 255, 255), 2)
    
    # 현재 활성 시나리오 정보 텍스트 표시
    action_text = "Action: N/A" # 기본값

    if active_scenario_global == 1:
        action_text = "Action: Scenario 1 (YOLO Detected)"
    elif active_scenario_global == 2:
        action_text = "Action: Scenario 2 (Palm-dominant Scrub)" 
    elif active_scenario_global == 3:
        action_text = "Action: Scenario 3 (Back-of-Hand Scrub)" 
    
    # YOLO가 감지한 동작 클래스 ID 추가 정보 (디버깅용)
    if current_action_from_yolo != -1:
        action_text += f" (YOLO Class: {current_action_from_yolo})"

    cv2.putText(image, action_text, (20, image.shape[0] - 20), cv2.FONT_HERSHEY_SIMPLEX, 0.7, (0, 255, 255), 2)

# =================================================================================
# 4. 메인 애플리케이션 실행 함수
# =================================================================================
def main():
    """
    주요 애플리케이션 실행 함수.
    카메라를 열고, YOLO 및 MediaPipe를 사용하여 손과 동작을 감지하고, 세척 상태를 시각화합니다.
    """
    try:
        # YOLO 모델 로드
        model = YOLO(YOLO_MODEL_PATH)
    except Exception as e:
        print(f"Error loading YOLO model: {e}")
        print(f"Please check if the model path '{YOLO_MODEL_PATH}' is correct and 'ultralytics' is installed.")
        return

    # MediaPipe Hands 모델 초기화
    hands = mp_hands.Hands(max_num_hands=2, min_detection_confidence=0.5, min_tracking_confidence=0.5)
    
    # 웹캠 열기
    cap = cv2.VideoCapture(0) # 0은 기본 웹캠을 의미합니다. 다른 카메라를 사용하려면 번호를 변경하세요.
    
    # 칼만 필터 딕셔너리 초기화
    kalman_left, kalman_right = {}, {}
    # 이전 프레임의 마지막으로 알려진 랜드마크 초기화
    last_known_landmarks = {"Left": None, "Right": None}
    
    # 손 씻기 상태 초기화
    reset_wash_status() # 상태 변수 초기화

    frame_counter = 0 # 프레임 카운터 (YOLO 추론 주기 제어용)
    current_detected_action = -1 # YOLO에서 현재 프레임에서 감지한 동작 클래스 ID

    while cap.isOpened():
        ret, frame = cap.read() # 프레임 읽기
        if not ret: # 프레임을 제대로 읽지 못하면 종료
            break
        
        frame = cv2.flip(frame, 1) # 좌우 반전 (거울 모드)
        image_rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB) # MediaPipe는 RGB 이미지를 사용

        h, w, _ = frame.shape # 프레임의 높이, 너비, 채널 수

        # YOLO 추론 주기 제어: YOLO_INFERENCE_INTERVAL에 따라 특정 프레임에서만 YOLO 실행
        if frame_counter % YOLO_INFERENCE_INTERVAL == 0:
            yolo_results = model(frame, verbose=False) # YOLO 모델 추론 (verbose=False로 출력 억제)
            
            action_this_frame = -1 # 이번 프레임의 YOLO 감지 액션 초기화
            if yolo_results and yolo_results[0].boxes: # 결과가 있고 박스가 감지된 경우
                # 변경된 부분: boxes 객체에서 xyxy, conf, cls를 직접 추출
                # xyxy는 numpy 배열, conf와 cls는 torch 텐서일 수 있으므로 .cpu().numpy() 적용
                detected_boxes_xyxy = yolo_results[0].boxes.xyxy.cpu().numpy()
                detected_confs = yolo_results[0].boxes.conf.cpu().numpy()
                detected_classes = yolo_results[0].boxes.cls.cpu().numpy()
                
                # 감지된 박스들을 하나의 리스트로 통합하여 처리하기 쉽게 만듭니다.
                # 각 요소는 (x1, y1, x2, y2, conf, cls) 튜플 형태가 됩니다.
                all_detections = []
                for i in range(len(detected_boxes_xyxy)):
                    x1, y1, x2, y2 = detected_boxes_xyxy[i]
                    conf = detected_confs[i]
                    cls = detected_classes[i]
                    all_detections.append((x1, y1, x2, y2, conf, cls))
                
                # 우선순위 클래스 정의 (0번과 2번)
                priority_classes = {0, 2}
                
                # 0번 또는 2번 클래스 중 가장 높은 신뢰도를 가진 박스 찾기
                best_priority_detection = None
                for detection_data in all_detections:
                    # 이제 detection_data는 (x1, y1, x2, y2, conf, cls) 튜플입니다.
                    cls = int(detection_data[5]) # 클래스 ID
                    conf = detection_data[4]     # 신뢰도
                    
                    if cls in priority_classes:
                        if best_priority_detection is None or conf > best_priority_detection[4]:
                            best_priority_detection = detection_data
                
                # 우선순위 클래스 (0번 또는 2번)가 감지되었다면 해당 클래스를 선택
                if best_priority_detection is not None:
                    action_this_frame = int(best_priority_detection[5])
                else:
                    # 우선순위 클래스가 감지되지 않았다면, 나머지 클래스 중 가장 높은 신뢰도의 박스 선택
                    if len(all_detections) > 0:
                        # 신뢰도 기준으로 정렬 (내림차순)
                        sorted_detections = sorted(all_detections, key=lambda d: d[4], reverse=True)
                        action_this_frame = int(sorted_detections[0][5])
            
            # YOLO가 감지한 원시 액션을 current_detected_action에 직접 할당
            current_detected_action = action_this_frame 


        # MediaPipe Hands 모델 처리
        hands_results = hands.process(image_rgb)
        
        temp_detected_hands_raw = []
        if hands_results.multi_hand_landmarks:
            for i, hand_landmarks_raw in enumerate(hands_results.multi_hand_landmarks):
                original_label = hands_results.multi_handedness[i].classification[0].label
                # 랜드마크 좌표를 픽셀 단위로 변환
                landmarks_pixel = {idx: (int(lm.x * w), int(lm.y * h)) for idx, lm in enumerate(hand_landmarks_raw.landmark)}
                
                # 손의 위치를 기준으로 왼손/오른손을 구분하기 위한 손목 X 좌표
                wrist_x = landmarks_pixel[0][0] if 0 in landmarks_pixel else w / 2 
                
                temp_detected_hands_raw.append({'label': original_label, 'landmarks': landmarks_pixel, 'wrist_x': wrist_x, 'hand_obj': hand_landmarks_raw})
        
        # 감지된 손을 'Left'와 'Right'로 정렬
        detected_hands = {"Left": None, "Right": None}
        if len(temp_detected_hands_raw) == 2:
            # 손목 X 좌표를 비교하여 왼손/오른손 구분 (왼손은 보통 X좌표가 작음)
            if temp_detected_hands_raw[0]['wrist_x'] < temp_detected_hands_raw[1]['wrist_x']:
                detected_hands["Left"] = temp_detected_hands_raw[0]['landmarks']
                detected_hands["Right"] = temp_detected_hands_raw[1]['landmarks']
            else:
                detected_hands["Left"] = temp_detected_hands_raw[1]['landmarks']
                detected_hands["Right"] = temp_detected_hands_raw[0]['landmarks']
        elif len(temp_detected_hands_raw) == 1:
            # 한 손만 감지된 경우 해당 라벨로 할당
            label = temp_detected_hands_raw[0]['label']
            detected_hands[label] = temp_detected_hands_raw[0]['landmarks']
        
        # 각 손의 방향 (손바닥/손등) 추정 및 안정화
        for label, landmarks in detected_hands.items():
            if landmarks:
                raw_orientation_is_palm = estimate_palm_direction(landmarks, label)
                is_stable_palm = (stable_orientations[label] == "palm")
                
                if raw_orientation_is_palm == is_stable_palm: 
                    orientation_counters[label] = 0 # 방향이 안정적이면 카운터 리셋
                else: 
                    orientation_counters[label] += 1 # 방향이 바뀌면 카운터 증가
                
                # 일정 프레임 이상 같은 방향이 유지되면 안정적인 방향으로 확정
                if orientation_counters[label] > ORIENTATION_CONFIRM_FRAMES:
                    stable_orientations[label] = "palm" if raw_orientation_is_palm else "back"
                    orientation_counters[label] = 0 # 확정 후 카운터 리셋

        # 칼만 필터를 사용하여 랜드마크 위치 부드럽게 만들기 (예측)
        predicted_left = update_kalman_filters(kalman_left, detected_hands["Left"])
        predicted_right = update_kalman_filters(kalman_right, detected_hands["Right"])
        
        # 칼만 필터가 예측한 랜드마크가 있으면 마지막으로 알려진 랜드마크 업데이트
        if predicted_left: last_known_landmarks["Left"] = predicted_left
        if predicted_right: last_known_landmarks["Right"] = predicted_right
        
        # 최종적으로 확정된 손 방향
        final_facing_left = (stable_orientations["Left"] == "palm")
        final_facing_right = (stable_orientations["Right"] == "palm")

        # 손의 세척 상태 업데이트 (YOLO 원시 액션 전달)
        update_cleansed_status(last_known_landmarks["Left"], last_known_landmarks["Right"], 
                               final_facing_left, final_facing_right, current_detected_action) # current_detected_action 전달

        # 손 랜드마크 및 세척 상태 시각화
        draw_hand_visuals(frame, last_known_landmarks["Left"], "Left", final_facing_left)
        draw_hand_visuals(frame, last_known_landmarks["Right"], "Right", final_facing_right)
        
        # 진행률 바 및 시나리오 정보 표시 (YOLO 원시 액션 전달)
        draw_progress_bar(frame, current_detected_action) # current_detected_action 전달

        # 화면에 프레임 표시
        cv2.imshow("Hand Wash Visualizer (Optimized)", frame)

        frame_counter += 1 # 프레임 카운터 증가

        # 키 입력 처리
        key = cv2.waitKey(5) & 0xFF
        if key == ord('q'): # 'q'를 누르면 종료
            break
        if key == ord('r'): # 'r'을 누르면 세척 상태 리셋
            reset_wash_status()
            frame_counter = 0 # 프레임 카운터 리셋


    # 자원 해제
    cap.release()
    hands.close()
    cv2.destroyAllWindows()

# 스크립트 직접 실행 시 main 함수 호출
if __name__ == '__main__':
    main()
