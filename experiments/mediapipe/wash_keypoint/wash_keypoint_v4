def estimate_palm_direction(landmarks, label):
    """
    주어진 손 랜드마크를 기반으로 손바닥의 방향(카메라를 향하고 있는지)을 추정합니다.
    이 함수는 손목(0번), 검지 손허리뼈(5번), 새끼손가락 손허리뼈(17번) 랜드마크를 사용하여
    손바닥의 법선 벡터를 계산하고, 이 법선 벡터의 Z축 성분으로 방향을 판단합니다.

    Args:
        landmarks (dict): MediaPipe에서 감지한 손 랜드마크의 픽셀 좌표 (예: {0: (x,y), 1:(x,y), ...}).
        label (str): 현재 손이 'Left'인지 'Right'인지 나타내는 문자열.

    Returns:
        bool: 손바닥이 카메라를 향하고 있으면 True, 손등이 향하고 있으면 False.
    """
    if not landmarks or not (0 in landmarks and 5 in landmarks and 17 in landmarks):
        # 랜드마크가 불충분하면 기본적으로 손바닥을 향하고 있다고 가정하거나, 상황에 따라 다른 기본값을 반환할 수 있음
        return True 
    
    wrist = np.array(landmarks[0])
    index_mcp = np.array(landmarks[5])
    pinky_mcp = np.array(landmarks[17])

    # 2D 좌표에 Z축 성분 0을 추가하여 3D 벡터로 만듭니다. (Z축은 화면 안쪽/바깥쪽을 나타냄)
    v1 = index_mcp - wrist
    v2 = pinky_mcp - wrist

    # 외적(cross product)을 사용하여 손바닥의 법선 벡터를 계산합니다.
    # 오른손 좌표계 규칙을 따릅니다.
    normal = np.cross(np.append(v1, 0), np.append(v2, 0))

    # 손의 라벨에 따라 법선 벡터의 Z축 성분을 확인하여 손바닥 방향을 추정합니다.
    # MediaPipe의 오른손 좌표계 특성을 고려합니다.
    if label == "Left":
        # 왼손의 경우 법선 벡터의 Z 성분이 음수이면 손바닥이 카메라를 향함 (화면 안쪽으로 뻗어 나가는 법선)
        return normal[2] < 0 
    else: # Right hand
        # 오른손의 경우 법선 벡터의 Z 성분이 양수이면 손바닥이 카메라를 향함 (화면 바깥쪽으로 뻗어 나가는 법선)
        return normal[2] > 0 

def create_kalman_filter(x, y):
    """
    주어진 초기 위치 (x, y)에 대한 2D 칼만 필터를 생성하고 초기화합니다.
    칼만 필터는 noisy한 측정값으로부터 시스템의 상태를 추정하는 데 사용됩니다.
    여기서는 손 랜드마크의 위치를 더 부드럽게 추적하는 데 활용됩니다.

    Args:
        x (int): 초기 X 좌표.
        y (int): 초기 Y 좌표.

    Returns:
        cv2.KalmanFilter: 초기화된 칼만 필터 객체.
    """
    kf = cv2.KalmanFilter(4, 2) # 상태 벡터 4개 (x, y, vx, vy), 측정 벡터 2개 (x, y)
    kf.transitionMatrix = np.array([[1, 0, 1, 0],  # x = x + vx
                                     [0, 1, 0, 1],  # y = y + vy
                                     [0, 0, 1, 0],  # vx = vx
                                     [0, 0, 0, 1]], np.float32) # vy = vy
    kf.measurementMatrix = np.eye(2, 4, dtype=np.float32) # 측정은 (x, y)만 이루어짐
    kf.processNoiseCov = np.eye(4, dtype=np.float32) * 0.03 # 프로세스 노이즈 공분산 (모델 불확실성)
    kf.measurementNoiseCov = np.eye(2, dtype=np.float32) * 0.5 # 측정 노이즈 공분산 (센서 불확실성)
    kf.statePost = np.array([[x], [y], [0], [0]], dtype=np.float32) # 초기 상태 (x, y, vx=0, vy=0)
    return kf

def update_kalman_filters(kalman_dict, detection):
    """
    주어진 감지된 랜드마크 데이터로 칼만 필터를 업데이트하고 예측된 위치를 반환합니다.

    Args:
        kalman_dict (dict): 각 랜드마크 인덱스에 매핑된 칼만 필터 객체들의 딕셔너리.
        detection (dict): 현재 프레임에서 감지된 랜드마크의 픽셀 좌표 (예: {0: (x,y), 1:(x,y), ...}).

    Returns:
        dict: 칼만 필터에 의해 예측된 각 랜드마크의 부드러운 픽셀 좌표.
    """
    predicted = {}
    if detection:
        for idx, (cx, cy) in detection.items():
            if idx not in kalman_dict:
                # 새로운 랜드마크가 감지되면 해당 랜드마크에 대한 칼만 필터 생성
                kalman_dict[idx] = create_kalman_filter(cx, cy)
            
            kf = kalman_dict[idx]
            kf.predict() # 다음 상태 예측
            kf.correct(np.array([[np.float32(cx)], [np.float32(cy)]])) # 측정값으로 보정
            
            predicted[idx] = (int(kf.statePost[0]), int(kf.statePost[1])) # 보정된 상태에서 위치 추출
    return predicted

